MAS parking {

	infrastructure: Jade

    agents:
        d1 driver_agent[beliefs="required_availability(1)"] at "drivers";
        d2 driver_agent[beliefs="required_availability(2)"] at "drivers";
        d3 driver_agent[beliefs="required_availability(3)"] at "drivers";
        d4 driver_agent[beliefs="required_availability(2)"] at "drivers";
        d5 driver_agent[beliefs="required_availability(1)"] at "drivers";

        a1 area_agent[beliefs="parking(p1),parking(p2)"] at "area1";
        p1 parking_agent[beliefs="area(a1),available(1)"] at "area1";
        p2 parking_agent[beliefs="area(a1),available(1)"] at "area1";

        a2 area_agent[beliefs="parking(p3),parking(p4),parking(p5)"] at "area2";
        p3 parking_agent[beliefs="area(a2),available(1)"] at "area2";
        p4 parking_agent[beliefs="area(a2),available(2)"] at "area2";
        p5 parking_agent[beliefs="area(a2),available(3)"] at "area2";

	aslSourcePath:
		"src/main/asl";
}