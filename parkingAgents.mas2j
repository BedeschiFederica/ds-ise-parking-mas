MAS parking {

	infrastructure: Jade

    agents:
        d1 driver_agent[beliefs="required_availability(1)", goals="start"] at "drivers";
        d2 driver_agent[beliefs="required_availability(2)", goals="start"] at "drivers";
        d3 driver_agent[beliefs="required_availability(3)", goals="start"] at "drivers";
        d4 driver_agent[beliefs="required_availability(2)", goals="start"] at "drivers";
        d5 driver_agent[beliefs="required_availability(1)", goals="start"] at "drivers";

        a1 area_agent[beliefs="parking(p1),parking(p2)", goals="start"] at "area1";
        p1 parking_agent[beliefs="area(a1),available(1)", goals="start"] at "area1";
        p2 parking_agent[beliefs="area(a1),available(1)", goals="start"] at "area1";

        a2 area_agent[beliefs="parking(p3),parking(p4),parking(p5)", goals="start"] at "area2";
        p3 parking_agent[beliefs="area(a2),available(3)", goals="start"] at "area2";
        p4 parking_agent[beliefs="area(a2),available(2)", goals="start"] at "area2";
        p5 parking_agent[beliefs="area(a2),available(3)", goals="start"] at "area2";

	aslSourcePath:
		"src/main/asl";
}